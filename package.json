{
  "name": "yottashift",
  "version": "0.1.0",
  "private": true,
  "description": "YottaShift: fair and feasible workforce scheduling (leave, shift coverage, skills, labour constraints) with a seeded synthetic dataset, validator and dashboard.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "node src/cli/generate.js",
    "validate": "node src/cli/validate.js",
    "reproduce": "node src/cli/reproduce.js",
    "api": "node src/cli/api.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "dependencies": {
    "express": "5.2.1"
  }
}
